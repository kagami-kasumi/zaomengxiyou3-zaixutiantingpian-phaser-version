{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zaixu-tianding:schema:incoming-number:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "truthId", "status", "visualTruth", "glyphs", "animation", "behavior", "behaviorNative", "unresolved"],
  "properties": {
