{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["truthId", "status", "forms", "contracts", "unresolvedBehavior", "deferred", "runtimeBoundary"],
  "properties": {
    "truthId": {"const": "task-settings-221.pet-turtle-behavior"},
    "status": {"const": "behavior-evidence"},
    "forms": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["form", "className", "baseClass", "rangeExpression", "attacksAt24Fps", "rowFrameCounts", "rowHolds", "skills", "source"]}},
    "contracts": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"type": "object", "required": ["id", "source", "fixtureSelector", "modernConsumer", "statement", "evidenceLevel", "geometry"], "properties": {"id": {"type":"string"}, "source": {"$ref":"#/$defs/source"}, "statement": {"type":"string", "minLength": 1}}}},
    "unresolvedBehavior": {"type": "array", "maxItems": 0},
    "deferred": {"type": "array", "minItems": 4},
    "runtimeBoundary": {"type":"string"}
  },
  "$defs": {"source": {"type": "object", "required": ["path", "method", "line", "sha256", "sliceSha256"], "properties": {"path":{"type":"string"},"method":{"type":"string"},"line":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sliceSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
}
