{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "truthId", "taskId", "status", "scope", "sources", "naturalDisplay", "inheritedDisplay", "geometry", "body", "evidence", "contractMatrix", "hostSemantics", "displayInventory", "completeness", "consumerBoundary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "truthId": {"const": "task-settings-229.pet-horse-collision-phase"},
    "taskId": {"const": "TASK-SETTINGS-229"},
    "status": {"enum": ["draft", "verified"]},
    "scope": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/reference"}},
    "naturalDisplay": {"type": "object"},
    "inheritedDisplay": {"type": "object", "required": ["ui", "geometry", "nativeTimeline", "hudInputs"]},
    "geometry": {"type": "object", "required": ["sources"]},
    "body": {"type": "object", "required": ["forms"]},
    "evidence": {"type": "object", "minProperties": 12, "additionalProperties": {"$ref": "#/$defs/reference"}},
    "contractMatrix": {"type": "array", "minItems": 43, "maxItems": 43, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceTruth", "sourceTruthSha256", "pointer", "supplementEvidence", "implementationTask"],
      "properties": {"id": {"type": "string"}, "sourceTruth": {"type": "string"}, "sourceTruthSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "pointer": {"type": "string"}, "supplementEvidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "implementationTask": {"const": "TASK-SLICE-226"}}
    }},
    "hostSemantics": {"type": "object"},
    "displayInventory": {"type": "object", "required": ["body", "principalEffects", "attached", "targets"]},
    "completeness": {"type": "object", "additionalProperties": false, "required": ["contractIds", "requiredEvidence", "unresolved"], "properties": {
      "contractIds": {"type": "array", "minItems": 43, "maxItems": 43, "uniqueItems": true, "items": {"type": "string"}},
      "requiredEvidence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "unresolved": {"type": "array", "items": {"type": "string"}}
    }},
    "consumerBoundary": {"type": "object", "required": ["implementationTask", "runtimeDataPolicy", "notProven"]}
  },
  "$defs": {"reference": {
    "type": "object", "additionalProperties": false, "required": ["path", "sha256", "locator"],
    "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "locator": {"type": "string", "minLength": 1}, "status": {"type": "string"}, "scope": {"type": ["string", "array"]}}
  }},
  "allOf": [{"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"completeness": {"properties": {"unresolved": {"maxItems": 0}}}}}}]
}
